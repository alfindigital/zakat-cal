# ZakatCal — Environment Variables
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# The public URL where this app is deployed (used in SEO/OG meta tags and JSON-LD).
# Example: https://zakatcal.example.com
VITE_SITE_URL=https://YOUR_DOMAIN

# Optional: Telegram handle for the "contact amil" deep-link feature.
# If left empty, the contact button will be hidden/disabled.
VITE_TELEGRAM_HANDLE=your_telegram_handle
